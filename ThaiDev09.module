#!name=Locket Gold - Thai Dev 09
#!desc=Module Locket Gold by Thai Dev 09 - Zalo: 0978249967

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# 1. Sửa lỗi Fake Gold RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/sb-doanthai/locket/refs/heads/main/locket.js, requires-body=true, max-size=-1, timeout=60

# 2. Xóa Header tránh bị checkpoint
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/sb-doanthai/locket/refs/heads/main/deleteHeader.js, timeout=60

# 3. Ép Gold từ Firebase
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/sb-doanthai/locket/refs/heads/main/forceGold.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
